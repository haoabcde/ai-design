{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional brochure plan; pageCount must match pages.length",
  "type": "object",
  "required": ["pageCount", "pages"],
  "properties": {
    "preset": { "type": "string" },
    "concept": { "type": "string" },
    "pageCount": { "type": "integer", "minimum": 1 },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "layout": { "type": "string" }
        }
      }
    }
  }
}
