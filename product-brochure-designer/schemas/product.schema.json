{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "description",
    "audience"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "itinerary": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "specifications": {
      "type": "object"
    },
    "brand": {
      "type": "object"
    },
    "audience": {
      "type": "string",
      "minLength": 1
    }
  },
  "title": "Optional public-facing product brief"
}
