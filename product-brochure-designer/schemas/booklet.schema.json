{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional image-generated booklet manifest; pages array is the final order",
  "type": "object",
  "required": ["pages"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "pageSize": { "enum": ["A4", "native"] },
    "brief": { "type": "string", "minLength": 1 },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "image", "prompt", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "generated", "reviewed"] },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "role"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
